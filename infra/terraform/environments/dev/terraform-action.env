# Controla o que a esteira CD Development executa ao entrar na branch develop.
# apply   = cria ou atualiza a Auth Lambda da Oficina Mecânica.
# destroy = destrói a Auth Lambda da Oficina Mecânica.
# Disparo controlado após a atualização das credenciais temporárias da AWS Academy.
TERRAFORM_ACTION=destroy
# Destroy dedicado: reconciliar cache isolado pela conta AWS do laboratório atual.
# Inicialização do state desta conta: exige inventário vazio pelo guardrail oficial.
# Repetir recuperação após corrigir o escopo de ambiente da proteção criptográfica.
